(use-modules (guix packages)
             (gnu)
             (guix utils)
             (guix git-download)
             (guix download)
             (gnu packages guile)
             (gnu packages nss)
             (gnu packages admin)
             (gnu packages web)
             (gnu packages gnupg)
             (gnu packages guile-xyz)
             (gnu packages pkg-config)
             (guix build-system guile)
             (gnu packages linux)
             (gnu packages compression)
             (gnu packages texinfo)
             (gnu packages autotools)
             (gnu packages rust-apps)
             ;; The channel pinned in channels.scm carries the release the
             ;; collection is built against; the prefix keeps it apart from the
             ;; older copies Guix itself carries.
             ((jointhefreeworld packages guile)
              #:prefix jtf:)
             ((guix licenses)
              #:prefix license:))

(packages->manifest (list guile-3.0
                          texinfo
                          watchexec
                          jtf:guile-scriba
                          guile-documenta
                          guile-ares-rs))
