((name . "Simple README")
 (prompts . (((key . project-name)
              (prompt . "Project Name")
              (type . string)
              (default . "my-awesome-project"))

             ((key . description)
              (prompt . "Short Project Description")
              (type . string)
              (default . "A cool project powered by Skapa."))

             ((key . author-name)
              (prompt . "Author Name")
              (type . string)
              (default . "Josep Bigorra"))

             ((key . include-guix)
              (prompt . "Include GNU Guix usage instructions?")
              (type . boolean)
              (default . #t)))))
