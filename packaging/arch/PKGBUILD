# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=skapa
pkgver=0.0.21
pkgrel=1
pkgdesc="Project scaffolding and templating wizard in Guile Scheme"
arch=('any')
url="https://github.com/jjba23/skapa"
license=('MIT')

depends=(
  'guile'
  'bash'
  'coreutils'
  'scriba'
)

makedepends=(
  'guile'
  'pkgconf'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('16b84b4a64125072d0bd47523d2457bc3a05a82f9679095dfb9ab82c546076ff')

# scriba is produced by the same packaging batch; build it first.

# Upstream reads resources from the generic share/resources; several of
# these packages would clash there, so it moves under share/skapa/.

# Guile looks for byte-compiled modules under the site-ccache directory,
# which differs between distributions, so ask Guile's pkg-config file
# instead of hard-coding a path.
_site_dir() {
  pkg-config --variable=sitedir guile-3.0 2>/dev/null \
    || echo /usr/share/guile/site/3.0
}

_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

build() {
  cd "$srcdir/$pkgname-$pkgver"

  # Byte-compile every module, mirroring the source tree under a staging
  # directory that package() copies into the compiled site directory.
  rm -rf "$srcdir/ccache"
  mkdir -p "$srcdir/ccache/skapa"

  while IFS= read -r scm_file; do
    rel_path="${scm_file#src/}"
    go_file="$srcdir/ccache/${rel_path%.scm}.go"
    mkdir -p "$(dirname "$go_file")"
    guild compile -L src -o "$go_file" "$scm_file"
  done < <(find src/skapa -name '*.scm')
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  # The launcher resolves its modules and resources relative to its
  # own prefix, so the installed layout below is what it expects.
  install -Dm755 scripts/skapa "$pkgdir/usr/bin/skapa"
  sed -i 's|share/resources|share/skapa/resources|g' "$pkgdir/usr/bin/skapa"

  site_dir="$(_site_dir)"
  install -d "$pkgdir${site_dir}/skapa"
  cp -r src/skapa/. "$pkgdir${site_dir}/skapa/"

  ccache_dir="$(_compiled_dir)"
  install -d "$pkgdir${ccache_dir}/skapa"
  cp -r "$srcdir/ccache/skapa/." "$pkgdir${ccache_dir}/skapa/"

  install -d "$pkgdir/usr/share/skapa/resources"
  cp -r resources/. "$pkgdir/usr/share/skapa/resources/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
}
